# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Qual IA classifica: anthropic (Claude, o padrão) ou gemini (Gemini no Vertex AI).
PROVEDOR_IA=anthropic

# Claude: chave da Anthropic (console.anthropic.com). Sem ela, a API usa só o plano B.
ANTHROPIC_API_KEY=
MODELO_LLM=claude-haiku-5-5

# Gemini no Vertex AI (Google Cloud). Não usa chave: vale o login do gcloud no computador
#   gcloud auth application-default login
# O projeto precisa do faturamento ativo e da API do Vertex AI ligada.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Modelos com preço na tabela (app/precos.py): gemini-3.5-flash-lite, gemini-3.8-flash,
# gemini-3.5-flash.
MODELO_GEMINI=gemini-3.5-flash-lite
# Quanto o Gemini pensa antes de responder: low, medium ou high.
# padrao = o padrão do modelo (use se algum modelo recusar o nível).
RACIOCINIO_GEMINI=low

# Chave que quem chama a API envia no cabeçalho X-API-Key.
# Vazia = API aberta. Use vazia só no seu computador.
CHAVE_API_APP=

# Banco. Sem PostgreSQL, a API usa um arquivo SQLite local.
DATABASE_URL=sqlite:///./triagem.db
# Senha do PostgreSQL que o docker compose sobe.
# Use só letras, números, - e _ : a senha entra no endereço de conexão do banco.
POSTGRES_PASSWORD=troque-esta-senha

# Abaixo desta confiança, o chamado vai para revisão humana.
LIMITE_CONFIANCA=0.75
# Preço do Claude em dólar por milhão de tokens. Confira em https://www.anthropic.com/pricing
# (o do Gemini vem da tabela em app/precos.py)
PRECO_ENTRADA_USD_MTOK=0.10
PRECO_SAIDA_USD_MTOK=0.50
TIMEOUT_LLM_S=20

# Página de demonstração no endereço principal. Aberta ao público e não grava nada.
DEMO_ATIVA=true
# Limite de testes por pessoa (endereço IP) por hora, e total por dia somando todo mundo.
DEMO_LIMITE_POR_HORA=10
DEMO_LIMITE_POR_DIA=200
# Endereço público da página, para a prévia do link no LinkedIn.
# Ex.: https://triagem-chamados-ia.up.railway.app (vazio = sem prévia)
URL_PUBLICA=
