# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Chave da Anthropic (console.anthropic.com). Sem ela, a API usa só o plano B por regras.
ANTHROPIC_API_KEY=
MODELO_LLM=claude-haiku-5-5

# Chave que quem chama a API envia no cabeçalho X-API-Key.
# Vazia = API aberta. Use vazia só no seu computador.
CHAVE_API_APP=

# Banco. Sem PostgreSQL, a API usa um arquivo SQLite local.
DATABASE_URL=sqlite:///./triagem.db
# Senha do PostgreSQL que o docker compose sobe.
# Use só letras, números, - e _ : a senha entra no endereço de conexão do banco.
POSTGRES_PASSWORD=troque-esta-senha

# Abaixo desta confiança, o chamado vai para revisão humana.
LIMITE_CONFIANCA=0.75
# Preço do modelo em dólar por milhão de tokens. Confira em https://www.anthropic.com/pricing
PRECO_ENTRADA_USD_MTOK=0.10
PRECO_SAIDA_USD_MTOK=0.50
TIMEOUT_LLM_S=20
